public void OnSendingChatMessage(SendingChatMessageEventArgs ev)
{
    else if (_plugin.CustomItemManager.IsWaitingForDrink(ev.Player))
    {
        ev.IsAllowed = false;
        _plugin.CustomItemManager.ProcessDrinkChoice(ev.Player, ev.Message);
    }
    else
    {
        ev.Player.SendConsoleMessage($"Неизвестная команда: .{command}", "red");
    }
}
